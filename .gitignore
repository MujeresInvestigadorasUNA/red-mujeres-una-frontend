# Archivos de dependencias (nunca subir esta carpeta)
# Se reinstala con `npm install`
node_modules/

# Archivos de build y caché de Next.js
# Se generan al construir o ejecutar el proyecto en desarrollo
.next/
out/

# Archivos de entorno local
# Contienen variables de entorno y secretos (API keys, contraseñas)
# ¡MUY IMPORTANTE no subir estos archivos a un repositorio público!
.env.local
.env.development.local
.env.test.local
.env.production.local

# Archivos de logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Archivos generados por el sistema operativo
.DS_Store
Thumbs.db

# Archivos de configuración de editores de código
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Archivos de test
coverage/